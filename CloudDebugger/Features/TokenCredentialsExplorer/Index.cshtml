@using CloudDebugger.SharedCode.Credentials
﻿@using Azure.MyIdentity
@model CloudDebugger.Features.TokenCredentialsExplorer.TokenCredentialsExplorerModel
@{
    ViewData["Title"] = "Cloud Debugger - TokenCredentials Explorer";
}

<h5>TokenCredentials Explorer</h5>
This tool will help you explore some of the different TokenCredentials in Azure.
<br />
<a href="/DefaultAzureCredentials">Back</a>
<br />
<br />

@if (!String.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        <pre>@Model.ErrorMessage</pre>
    </div>
}

@if (!String.IsNullOrWhiteSpace(Model.Message))
{
    <b>@Model.Message</b>
}

<form method="get" action="/TokenCredentialsExplorer/Index">
    <div class="form-group">
        <label for="clientId">Client ID (optional):</label>
        <input type="text" class="form-control" id="clientId" name="clientId" value="@Model.ClientId" size="40" style="width:40ch;" />
        Only used by DefaultAzureCredentials and ManagedIdentityCredential.
    </div>
    <br />

    <table class="table table-bordered">
        <tr>
            <th>
                <h4>Token Credentials</h4>
            </th>
            <th>
                @if (Model.CredentialName != null)
                {
                    <h5>@Model.CredentialName</h5>
                }
            </th>
        </tr>
        <tr>
            <!-- Column 1 start -->
            <td class="col-md-3">
                Select a token credentials to explore.
                <br /><br />


                @* Not all credentials are supported for various reasons *@
                @*      <a href="Index?Credential=1">AuthorizationCodeCredential</a><br>*@


                @if (Model.CurrentCredentialType == CredentialType.AzureCliCredential)
                {
                    <button type="submit" name="CredentialId" value="@((int)CredentialType.AzureCliCredential)" class="btn btn-link"><b>AzureCliCredential</b></button>
                    <br>
                }
                else
                {
                    <button type="submit" name="CredentialId" value="@((int)CredentialType.AzureCliCredential)" class="btn btn-link">AzureCliCredential</button>
                    <br>
                }

                @if (Model.CurrentCredentialType == CredentialType.AzureDeveloperCliCredential)
                {
                    <button type="submit" name="CredentialId" value="@((int)CredentialType.AzureDeveloperCliCredential)" class="btn btn-link"><b>AzureDeveloperCliCredential</b></button>
                    <br>
                }
                else
                {
                    <button type="submit" name="CredentialId" value="@((int)CredentialType.AzureDeveloperCliCredential)" class="btn btn-link">AzureDeveloperCliCredential</button>
                    <br>
                }

                @if (Model.CurrentCredentialType == CredentialType.AzurePipelinesCredential)
                {
                    <button type="submit" name="CredentialId" value="@((int)CredentialType.AzurePipelinesCredential)" class="btn btn-link"><b>AzurePipelinesCredential</b></button>
                    <br>
                }
                else
                {
                    <button type="submit" name="CredentialId" value="@((int)CredentialType.AzurePipelinesCredential)" class="btn btn-link">AzurePipelinesCredential</button>
                    <br>
                }

                @if (Model.CurrentCredentialType == CredentialType.AzurePowerShellCredential)
                {
                    <button type="submit" name="CredentialId" value="@((int)CredentialType.AzurePowerShellCredential)" class="btn btn-link"><b>AzurePowerShellCredential</b></button>
                    <br>
                }
                else
                {
                    <button type="submit" name="CredentialId" value="@((int)CredentialType.AzurePowerShellCredential)" class="btn btn-link">AzurePowerShellCredential</button>
                    <br>
                }

                @if (Model.CurrentCredentialType == CredentialType.BrokerCredential)
                {
                    <button type="submit" name="CredentialId" value="@((int)CredentialType.BrokerCredential)" class="btn btn-link"><b>BrokerCredential</b></button>
                    <br>
                }
                else
                {
                    <button type="submit" name="CredentialId" value="@((int)CredentialType.BrokerCredential)" class="btn btn-link">BrokerCredential</button>
                    <br>
                }

                @if (Model.CurrentCredentialType == CredentialType.DefaultAzureCredential)
                {
                    <button type="submit" name="CredentialId" value="@((int)CredentialType.DefaultAzureCredential)" class="btn btn-link"><b>DefaultAzureCredential</b></button>
                    <br>
                }
                else
                {
                    <button type="submit" name="CredentialId" value="@((int)CredentialType.DefaultAzureCredential)" class="btn btn-link">DefaultAzureCredential</button>
                    <br>
                }
 
                @if (Model.CurrentCredentialType == CredentialType.EnvironmentCredential)
                {
                    <button type="submit" name="CredentialId" value="@((int)CredentialType.EnvironmentCredential)" class="btn btn-link"><b>EnvironmentCredential</b></button>
                    <br>
                }
                else
                {
                    <button type="submit" name="CredentialId" value="@((int)CredentialType.EnvironmentCredential)" class="btn btn-link">EnvironmentCredential</button>
                    <br>
                }

                @if (Model.CurrentCredentialType == CredentialType.InteractiveBrowserCredential)
                {
                    <button type="submit" name="CredentialId" value="@((int)CredentialType.InteractiveBrowserCredential)" class="btn btn-link"><b>InteractiveBrowserCredential</b></button>
                    <br>
                }
                else
                {
                    <button type="submit" name="CredentialId" value="@((int)CredentialType.InteractiveBrowserCredential)" class="btn btn-link">InteractiveBrowserCredential</button>
                    <br>
                }

                @if (Model.CurrentCredentialType == CredentialType.ManagedIdentityCredential)
                {
                    <button type="submit" name="CredentialId" value="@((int)CredentialType.ManagedIdentityCredential)" class="btn btn-link"><b>ManagedIdentityCredential</b></button>
                    <br>
                }
                else
                {
                    <button type="submit" name="CredentialId" value="@((int)CredentialType.ManagedIdentityCredential)" class="btn btn-link">ManagedIdentityCredential</button>
                    <br>
                }

                @if (Model.CurrentCredentialType == CredentialType.VisualStudioCodeCredential)
                {
                    <button type="submit" name="CredentialId" value="@((int)CredentialType.VisualStudioCodeCredential)" class="btn btn-link"><b>VisualStudioCodeCredential</b></button>
                    <br>
                }
                else
                {
                    <button type="submit" name="CredentialId" value="@((int)CredentialType.VisualStudioCodeCredential)" class="btn btn-link">VisualStudioCodeCredential</button>
                    <br>
                }

                @if (Model.CurrentCredentialType == CredentialType.VisualStudioCredential)
                {
                    <button type="submit" name="CredentialId" value="@((int)CredentialType.VisualStudioCredential)" class="btn btn-link"><b>VisualStudioCredential</b></button>
                    <br>
                }
                else
                {
                    <button type="submit" name="CredentialId" value="@((int)CredentialType.VisualStudioCredential)" class="btn btn-link">VisualStudioCredential</button>
                    <br>
                }

                @if (Model.CurrentCredentialType == CredentialType.WorkloadIdentityCredential)
                {
                    <button type="submit" name="CredentialId" value="@((int)CredentialType.WorkloadIdentityCredential)" class="btn btn-link"><b>WorkloadIdentityCredential</b></button>
                    <br />
                }
                else
                {
                    <button type="submit" name="CredentialId" value="@((int)CredentialType.WorkloadIdentityCredential)" class="btn btn-link">WorkloadIdentityCredential</button>
                    <br />
                }
            </td>
            <!-- Column 1 end -->
            <!-- Column 2 start -->
            <td class="col-md-9">
                <table>
                    <tr>
                        <th></th>
                    </tr>

                    @if (Model.CredentialMessage != null)
                    {
                        <tr>
                            <td>
                                @Model.CredentialMessage<br />
                            </td>
                        </tr>
                    }

                    @if (Model.Log != null && Model.Log.Count > 0)
                    {
                        <tr>
                            <td>
                                <h6>Internal Execution log</h6>
                            </td>
                        </tr>

                        foreach (var entry in Model.Log)
                        {
                            <tr>
                                <td>
                                    <pre>@entry</pre>
                                </td>
                            </tr>
                        }
                    }

                    @if (Model.AccessToken.Token != null)
                    {
                        <tr>
                            <td>
                                <h5>Access Token</h5>
                            </td>
                        </tr>
                        <tr>
                            <td id="access_token" style="width: 500px; word-wrap: break-word; display: inline-block; vertical-align: top;">
                                @(Model.AccessToken.Token ?? "No token found")
                            </td>
                        </tr>
                        <tr>
                            <td>
                                @if (Model.UrlToJWTIOSite != null)
                                {
                                    <br />
                                    <br />
                                    
                                    @:Explore the access token on <a href="@Model.UrlToJWTIOSite" target="_blank">https://jwt.io</a> or <a href="@Model.UrlToJWTMSSite" target="_blank">https://jwt.ms</a><br />
                                }
                            </td>
                        </tr>
                    }
                </table>
            </td>
            <!-- Column 2 end -->
        </tr>
    </table>
</form>

<br />
<br />

<h5>Resources</h5>
<ul>
    <li><a href="https://github.com/tndata/CloudDebugger/wiki/TokenExplorer">Documentation</a></li>
    <li><a href="https://learn.microsoft.com/en-us/dotnet/api/azure.identity">Azure.Identity Namespace</a></li>
</ul>
